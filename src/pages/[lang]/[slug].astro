---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { languagesList, type Lang } from '../../i18n/ui';
import { subSlugs, subPageFor } from '../../data/subpages';
import { entity, siteConfig } from '../../config';
import th from '../../i18n/th.json';
import en from '../../i18n/en.json';
import zh from '../../i18n/zh.json';

export function getStaticPaths() {
  return languagesList.flatMap((lang) =>
    subSlugs.map((slug) => ({ params: { lang, slug } }))
  );
}

const lang = Astro.params.lang as Lang;
const slug = String(Astro.params.slug);
const m = { th, en, zh }[lang];
const page = subPageFor(lang, slug)!;
const ui = m.subpages;
// Publication date for the Article schema — bump it when a page is materially rewritten.
const articleDate = '2026-09-14';

// Internal linking: every sub-page links to the other three + back to the main guide.
const siblings = subSlugs
  .filter((s) => s !== slug)
  .map((s) => subPageFor(lang, s)!)
  .filter(Boolean);
---

<BaseLayout
  lang={lang}
  title={page.title}
  description={page.description}
  messages={m}
  faqs={page.faqs}
  crumbs={[entity.fullName, entity.city, page.nav]}
  article={{
    headline: page.heading,
    description: page.description,
    section: page.nav,
    datePublished: articleDate,
    dateModified: articleDate,
  }}
  howTo={page.howTo}
>
  <Header lang={lang} messages={m} />
  <main>
    <article class="bg-ivory text-ink">
      <div class="max-w-3xl mx-auto px-5 pt-28 pb-20">
        <a
          href={`/${lang}/`}
          class="inline-flex items-center gap-1 text-sm text-teak hover:text-gold transition"
        >
          ← {ui.back}
        </a>
        <p class="mt-6 font-hand text-gold text-xl md:text-2xl">{page.label}</p>
        <h1 class="font-display font-semibold text-4xl md:text-5xl text-teak leading-tight mt-2">
          {page.heading}
        </h1>
        <p class="mt-5 text-lg text-ink/80 leading-relaxed">{page.lead}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink/60">
          <span>{entity.streetAddress}</span>
          <span aria-hidden="true">·</span>
          <span>{siteConfig.plusCode} {entity.city}</span>
          <span aria-hidden="true">·</span>
          <span>{m.guide.hours.time}</span>
        </div>
      </div>

      <div class="max-w-3xl mx-auto px-5 pb-8 space-y-12">
        {
          page.sections.map((s, i) => (
            <section id={`s${i + 1}`} class="scroll-mt-24">
              <h2 class="font-display text-2xl md:text-3xl text-teak font-semibold">{s.h}</h2>
              <p class="mt-3 text-ink/80 leading-relaxed">{s.p}</p>
              {s.bullets && (
                <ul class="mt-4 space-y-2 text-sm text-ink/75">
                  {s.bullets.map((b) => (
                    <li class="flex gap-2">
                      <span class="text-gold mt-0.5" aria-hidden="true">
                        •
                      </span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))
        }
      </div>

      <!-- FAQ: mirrors the FAQPage JSON-LD emitted by BaseLayout -->
      <div class="max-w-3xl mx-auto px-5 pb-16">
        <h2 class="font-display text-2xl text-teak mb-5">{ui.faqTitle}</h2>
        <div class="space-y-3">
          {
            page.faqs.map((f) => (
              <details class="group rounded-xl border border-gold/25 bg-white/50 p-4 open:bg-teak/5">
                <summary class="cursor-pointer font-medium text-teak flex justify-between items-center">
                  {f.q}
                  <span class="text-gold transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 text-sm text-ink/75">{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>

      <!-- Cross-links: keeps the four deep-dive pages in one cluster -->
      <div class="max-w-3xl mx-auto px-5 pb-24">
        <h2 class="font-display text-2xl text-teak mb-5">{ui.readNext}</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {
            siblings.map((s) => (
              <a
                href={`/${lang}/${s.slug}/`}
                class="group rounded-2xl border border-gold/25 bg-white/50 p-5 hover:border-gold hover:shadow-md transition"
              >
                <div class="font-display text-teak font-semibold text-lg">{s.nav}</div>
                <p class="mt-1 text-sm text-ink/70">{s.heading}</p>
                <span class="mt-3 inline-block text-sm text-gold group-hover:text-goldBright">
                  → {ui.cta}
                </span>
              </a>
            ))
          }
        </div>
        <a
          href={`/${lang}/`}
          class="mt-8 inline-block rounded-full bg-teak px-6 py-3 font-medium text-ivory hover:bg-teakDeep transition"
        >
          {ui.backToGuide}
        </a>
      </div>
    </article>
  </main>
  <Footer lang={lang} messages={m} />
</BaseLayout>
