---
/**
 * Serves the optimised WebP copy of a photo with the compressed JPEG as fallback.
 * Photos are pre-processed (resized / re-encoded) at build time, so no runtime
 * image service is needed on Cloudflare Workers.
 */
interface Props {
  src: string;
  alt: string;
  imgClass?: string;
  pictureClass?: string;
  loading?: 'lazy' | 'eager';
  sizes?: string;
  width?: number;
  height?: number;
  style?: string;
}
const {
  src,
  alt,
  imgClass = '',
  pictureClass = '',
  loading = 'lazy',
  sizes,
  width,
  height,
  style,
} = Astro.props;
const webp = src.replace(/\.(jpe?g|png)$/i, '.webp');
---

<picture class={pictureClass}>
  <source srcset={webp} type="image/webp" />
  <img
    src={src}
    alt={alt}
    class={imgClass}
    loading={loading}
    decoding="async"
    sizes={sizes}
    width={width}
    height={height}
    style={style}
  />
</picture>
