---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const s = messages.seasons;
const cols: string[] = s.columns ?? [];
const rows: any[] = s.rows ?? [];
---

<section id="seasons" class="py-20 bg-ivory text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{s.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{s.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{s.intro}</p>

    <div class="mt-10 overflow-x-auto rounded-2xl border border-gold/30">
      <table class="w-full min-w-[880px] text-sm">
        <thead class="bg-teak text-ivory">
          <tr>
            {
              cols.map((c: string) => (
                <th class="text-left font-display font-semibold px-4 py-3 whitespace-nowrap">{c}</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r: any, i: number) => (
              <tr class={i % 2 === 0 ? 'bg-white/60' : 'bg-gold/5'}>
                <td class="px-4 py-4 align-top font-display text-teak whitespace-nowrap">{r.season}</td>
                <td class="px-4 py-4 align-top whitespace-nowrap">{r.months}</td>
                <td class="px-4 py-4 align-top whitespace-nowrap">{r.temp}</td>
                <td class="px-4 py-4 align-top">{r.rain}</td>
                <td class="px-4 py-4 align-top">{r.air}</td>
                <td class="px-4 py-4 align-top text-ink/80">{r.advice}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 text-xs leading-relaxed text-ink/55 max-w-4xl">{s.climateNote}</p>
    <p class="mt-4 rounded-xl border border-gold/25 bg-gold/5 px-4 py-3 text-sm text-teak">
      {s.tip}
    </p>
  </div>
</section>
