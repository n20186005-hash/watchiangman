---
import { getWeather, codeIcon, codeKey } from '../lib/weather';
import { buildAdvice, dayTip, humidityBand, uvBand, windBand } from '../lib/weatherAdvice';
import { messagesFor, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const w = messagesFor(lang).weather;
const data = await getWeather();

const localeMap: Record<Lang, string> = { th: 'th-TH', en: 'en-GB', zh: 'zh-CN' };
const intlLocale = localeMap[lang] ?? 'en-GB';

const weekday = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString(intlLocale, { weekday: 'short' });
const dayNum = (iso: string) =>
  new Date(`${iso}T00:00:00`).toLocaleDateString(intlLocale, { day: 'numeric', month: 'short' });

const observed = data
  ? new Date(data.observedAt).toLocaleString(intlLocale, {
      hour: '2-digit',
      minute: '2-digit',
      day: 'numeric',
      month: 'short',
    })
  : '';

/** Resolve an advice key to its localised sentence. */
const pick = (group: string, key: string): string => w?.advice?.[group]?.[key] ?? key;
const level = (group: string, key: string): string => w?.levels?.[group]?.[key] ?? key;
const gearName = (key: string): string => w?.gear?.[key] ?? key;
const tipName = (key: string): string => w?.tips?.[key] ?? key;
const condName = (code: number): string => w?.codes?.[codeKey(code)] ?? w?.codes?.clear ?? '';

const advice = data ? buildAdvice(data) : null;
const humKey = data ? humidityBand(data.now.humidity) : 'comfy';
const uvKey = data ? uvBand(data.today?.uvMax ?? 0) : 'low';
const windKey = data ? windBand(data.now.wind) : 'calm';

const dressList = advice && advice.dress.length ? advice.dress : ['ok'];
const planList = advice && advice.plan.length ? advice.plan : ['ok'];

const summary = data
  ? [
      condName(data.now.code),
      `${data.today?.tmin ?? data.now.temp}–${data.today?.tmax ?? data.now.temp}°`,
      `${w?.uv ?? ''} ${level('uv', uvKey)}`.trim(),
      level('wind', windKey),
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
---

<section id="weather" class="py-20 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{w.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{w.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{w.intro}</p>

    {
      data && advice ? (
        <>
          <div class="mt-10 grid lg:grid-cols-12 gap-6">
            {/* Current conditions */}
            <div class="lg:col-span-5 rounded-2xl border border-gold/25 bg-white/5 p-6">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="text-xs uppercase tracking-wider text-gold">{w.nowLabel}</div>
                  <div class="font-display text-6xl text-goldBright leading-none mt-2">
                    {data.now.temp}°<span class="text-2xl text-ivory/60">C</span>
                  </div>
                  <div class="mt-2 text-ivory/85">{condName(data.now.code)}</div>
                </div>
                <div class="text-5xl" aria-hidden="true">{codeIcon(data.now.code, data.now.isDay)}</div>
              </div>

              <p class="mt-3 text-sm text-ivory/70">{summary}</p>

              <dl class="mt-6 grid grid-cols-2 gap-3 text-sm">
                <div class="rounded-xl bg-teak/40 px-4 py-3">
                  <dt class="text-ivory/55 text-xs">{w.feelsLike}</dt>
                  <dd class="font-display text-xl text-ivory">{data.now.apparent}°C</dd>
                </div>
                <div class="rounded-xl bg-teak/40 px-4 py-3">
                  <dt class="text-ivory/55 text-xs">{w.humidityPlain ?? w.humidity}</dt>
                  <dd class="font-display text-xl text-ivory">{level('humidity', humKey)}</dd>
                  <dd class="text-[11px] text-ivory/45">{level('humidityNote', humKey)}</dd>
                </div>
                <div class="rounded-xl bg-teak/40 px-4 py-3">
                  <dt class="text-ivory/55 text-xs">{w.windPlain ?? w.wind}</dt>
                  <dd class="font-display text-xl text-ivory">{level('wind', windKey)}</dd>
                  <dd class="text-[11px] text-ivory/45">{data.now.wind} {w.windUnit}</dd>
                </div>
                <div class="rounded-xl bg-teak/40 px-4 py-3">
                  <dt class="text-ivory/55 text-xs">{w.rainChance}</dt>
                  <dd class="font-display text-xl text-ivory">{data.today?.precipProb ?? 0}%</dd>
                </div>
              </dl>

              {/* Plain-language takeaway: do I need an umbrella? */}
              <div
                class={`mt-5 rounded-xl border px-4 py-3 text-sm ${
                  data.umbrellaToday
                    ? 'border-goldBright/50 bg-gold/15 text-gold'
                    : 'border-ivory/15 bg-ivory/5 text-ivory/80'
                }`}
              >
                <span class="font-semibold">{w.umbrellaTitle} </span>
                {data.umbrellaToday ? w.umbrellaYes : w.umbrellaNo}
              </div>

              <p class="mt-4 text-[11px] text-ivory/45">
                {w.observedLabel} {observed} · {w.placeLabel} {data.place}
              </p>
            </div>

            {/* Multi-day forecast */}
            <div class="lg:col-span-7 rounded-2xl border border-gold/25 bg-white/5 p-6">
              <div class="flex items-baseline justify-between">
                <h3 class="font-display text-xl text-goldBright">{w.forecastTitle}</h3>
                <span class="text-xs text-ivory/50">{w.forecastDays}</span>
              </div>

              <ul class="mt-4 divide-y divide-ivory/10">
                {data.days.map((d, i) => (
                  <li class="grid grid-cols-[3.5rem_2rem_1fr_auto] items-center gap-3 py-3">
                    <div class="text-sm">
                      <div class="font-semibold">{i === 0 ? w.todayLabel : weekday(d.date)}</div>
                      <div class="text-[11px] text-ivory/45">{dayNum(d.date)}</div>
                    </div>
                    <div class="text-2xl text-center" aria-hidden="true">{codeIcon(d.code)}</div>
                    <div class="text-sm text-ivory/85">
                      {condName(d.code)}
                      <span class="ml-2 text-ivory/45">{d.precipProb}%</span>
                      <span class="ml-2 inline-flex items-center rounded-full border border-gold/30 px-2 py-0.5 text-[11px] text-gold">
                        {tipName(dayTip(d))}
                      </span>
                    </div>
                    <div class="text-right whitespace-nowrap">
                      <span class="font-display text-lg text-ivory">{d.tmax}°</span>
                      <span class="text-ivory/45 text-sm"> / {d.tmin}°</span>
                    </div>
                  </li>
                ))}
              </ul>

              <p class="mt-4 text-[11px] text-ivory/45">{w.forecastNote}</p>
            </div>
          </div>

          {/* Actionable advice — only the conditions that are actually true */}
          <div class="mt-6">
            {advice.alerts.length > 0 ? (
              <div class="rounded-2xl border border-red-400/50 bg-red-500/10 p-4 md:p-5">
                <div class="flex items-center gap-2 text-sm font-semibold text-red-200">
                  <span aria-hidden="true">⚠️</span>
                  {w.advice.blocks.alert}
                </div>
                <ul class="mt-2 space-y-1 text-sm text-red-100/90">
                  {advice.alerts.map((a) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true">·</span>
                      <span>{pick('alert', a)}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <div class="rounded-2xl border border-ivory/15 bg-ivory/5 px-4 py-3 text-sm text-ivory/75">
                <span aria-hidden="true">✅</span> {w.advice.none}
              </div>
            )}

            <div class="mt-4 grid gap-4 md:grid-cols-3">
              <div class="rounded-2xl border border-gold/25 bg-white/5 p-5">
                <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-gold">
                  <span aria-hidden="true">👕</span>
                  {w.advice.blocks.dress}
                </div>
                <ul class="mt-3 space-y-2 text-sm text-ivory/85">
                  {dressList.map((k) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-gold">›</span>
                      <span>{pick('dress', k)}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-2xl border border-gold/25 bg-white/5 p-5">
                <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-gold">
                  <span aria-hidden="true">🧭</span>
                  {w.advice.blocks.plan}
                </div>
                <ul class="mt-3 space-y-2 text-sm text-ivory/85">
                  {planList.map((k) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-gold">›</span>
                      <span>{pick('plan', k)}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="rounded-2xl border border-gold/25 bg-white/5 p-5">
                <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-gold">
                  <span aria-hidden="true">🎒</span>
                  {w.advice.blocks.gear}
                </div>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {advice.gear.map((g) => (
                    <li class="rounded-full border border-gold/30 bg-gold/10 px-3 py-1 text-sm text-goldBright">
                      {gearName(g)}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-4 rounded-2xl border border-gold/25 bg-white/5 p-5">
              <div class="flex items-center gap-2 text-xs uppercase tracking-wider text-gold">
                <span aria-hidden="true">🕘</span>
                {w.advice.blocks.best}
              </div>
              <p class="mt-2 text-sm text-ivory/85">{pick('best', advice.best)}</p>
            </div>

            <p class="mt-3 text-[11px] text-ivory/40">{w.advice.auto}</p>
          </div>
        </>
      ) : (
        <p class="mt-8 rounded-2xl border border-ivory/15 bg-white/5 p-6 text-sm text-ivory/70">
          {w.unavailable}
        </p>
      )
    }
  </div>
</section>
