---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const l = messages.legends;
const stories: any[] = l.stories ?? [];
---

<section id="legends" class="py-20 bg-white text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{l.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{l.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{l.intro}</p>

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      {
        stories.map((s: any, i: number) => (
          <article
            class={`rounded-2xl border border-gold/25 bg-ivory/60 p-6 ${i === 0 ? 'md:col-span-2' : ''}`}
          >
            <span class="inline-block rounded-full bg-teak px-3 py-1 text-[11px] uppercase tracking-wider text-goldBright">
              {s.tag}
            </span>
            <h3 class="mt-3 font-display text-xl md:text-2xl text-teak">{s.title}</h3>
            <p class="mt-3 text-sm md:text-base leading-relaxed text-ink/85">{s.text}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-xs leading-relaxed text-ink/55 max-w-4xl">{l.note}</p>
  </div>
</section>
