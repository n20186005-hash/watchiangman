---
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; messages: Record<string, any>; }
const { lang } = Astro.props;
const names = { th: 'วัดเชียงมั่น', en: 'Wat Chiang Man', zh: '清曼寺' };
const notices = {
  th: 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐหรือองค์กรทางการใด ๆ',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
};
---
<footer class="bg-teakDeep text-ivory py-8">
  <div class="max-w-7xl mx-auto px-5 text-center text-sm leading-relaxed">
    <p>© 2026 {names[lang]} · {lang === 'th' ? 'สงวนลิขสิทธิ์' : lang === 'en' ? 'All rights reserved' : '版权所有'}</p>
    <p class="mt-2 text-ivory/65">{notices[lang]}</p>
  </div>
</footer>
