---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const e = messages.etiquette;
const chant = e?.chant;
---

{
  e && (
    <section id="etiquette" class="py-20 bg-teakDeep text-ivory">
      <div class="max-w-7xl mx-auto px-5">
        <p class="font-hand text-gold text-xl md:text-2xl">{e.label}</p>
        <h2 class="font-display font-semibold text-3xl md:text-5xl mt-2">{e.heading}</h2>
        <p class="mt-4 max-w-2xl text-ivory/80">{e.lead}</p>

        <div class="mt-10 grid md:grid-cols-3 gap-5">
          {e.columns.map((c: any) => (
            <div class="rounded-2xl border border-gold/25 bg-ivory/5 p-6">
              <h3 class="font-display text-xl text-gold">{c.title}</h3>
              <ul class="mt-3 space-y-2 text-sm text-ivory/80">
                {c.items.map((it: any) => (
                  <li class="flex gap-2">
                    <span class="text-gold mt-0.5" aria-hidden="true">
                      •
                    </span>
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {chant && (
          <div class="mt-8 rounded-2xl border border-gold/30 bg-ivory/5 p-6 max-w-4xl">
            <h3 class="font-display text-xl text-gold">{chant.title}</h3>
            <p class="mt-1 text-xs uppercase tracking-widest text-ivory/50">{chant.verseLabel}</p>
            <p class="mt-2 font-display text-lg text-ivory">{chant.verse}</p>
            <p class="mt-3 text-sm text-ivory/80 leading-relaxed">{chant.meaning}</p>
            <p class="mt-2 text-sm text-ivory/60 leading-relaxed">{chant.note}</p>
          </div>
        )}

        <a
          href={`/${lang}/visitor-guide/`}
          class="mt-8 inline-flex items-center gap-2 rounded-full border border-gold px-6 py-3 font-medium text-gold hover:bg-gold hover:text-teakDeep transition"
        >
          {e.cta} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}
