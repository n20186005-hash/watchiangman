---
import { siteConfig } from '../config';

interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const reviews = messages.reviews;
const mapsUrl = siteConfig.mapsUrl;

const stars = (r: string) => {
  const n = Math.round(parseFloat(r));
  return '★'.repeat(n) + '☆'.repeat(5 - n);
};
---

<section id="reviews" class="py-20 bg-teakDeep text-ivory">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{reviews.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-ivory mt-2">{reviews.heading}</h2>
    <p class="mt-4 max-w-2xl text-ivory/80">{reviews.intro}</p>

    <!-- 聚合评分快照（来自 Google Maps，标注最近核对日期；不转载逐条评价） -->
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <span class="stars text-2xl">{stars(siteConfig.rating)}</span>
      <span class="font-display text-2xl text-goldBright">{siteConfig.rating}</span>
      <span class="text-ivory/70">{messages.hero.reviewCount}</span>
    </div>
    <p class="mt-2 text-xs text-ivory/50">{reviews.disclaimer}</p>
    <p class="mt-1 text-xs text-ivory/50">{reviews.declaration}</p>

    <!-- 评价来源与核对时间（评价仅在本页展示，不写入 JSON-LD） -->
    <p class="mt-4 max-w-3xl rounded-xl border border-gold/25 bg-teak/40 px-4 py-3 text-xs leading-relaxed text-ivory/75">
      <span class="text-goldBright font-semibold">{reviews.sourceNotesLabel}</span> — {reviews.sourceNote}
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-1 text-goldBright underline underline-offset-2 hover:text-gold"
      >
        {reviews.viewAllCta} ↗
      </a>
    </p>

    <div class="mt-10 flex flex-col items-center gap-3">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-ivory border border-gold/50 px-6 py-3 rounded-full hover:bg-gold hover:text-teak transition-colors">
        {reviews.viewAllCta ?? reviews.viewLocation}
      </a>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-ivory/50 hover:text-goldBright underline underline-offset-2 hover:underline">
        {reviews.viewLocation}
      </a>
    </div>
  </div>
</section>
