---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
const items: any[] = f.items ?? [];
---

<section id="facilities" class="py-20 bg-white text-ink">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{f.intro}</p>

    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        items.map((it: any) => (
          <article class="rounded-2xl border border-gold/25 bg-ivory/60 p-5 h-full">
            <div class="text-2xl" aria-hidden="true">{it.icon}</div>
            <h3 class="mt-2 font-display text-lg text-teak">{it.title}</h3>
            <p class="mt-1 text-[11px] uppercase tracking-wide text-gold">{it.type}</p>
            <p class="mt-3 text-sm text-ink/80">{it.text}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-[11px] leading-relaxed text-ink/55 max-w-4xl">{f.neutralNote}</p>
    <p class="mt-3 rounded-xl border border-gold/25 bg-gold/5 px-4 py-3 text-sm text-teak">
      {f.walkingNote}
    </p>
  </div>
</section>
